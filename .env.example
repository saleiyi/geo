# Public website origin. Leave blank for local development.
# On Render only, a blank SITE_URL falls back to the platform's RENDER_EXTERNAL_URL.
# Use your real public domain, without a path, query, credentials or fragment.
# Example: SITE_URL=https://geo.your-real-domain.com
SITE_URL=

# Keep false on local/preview environments. Enable only after HTTPS launch checks.
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=

# Public operator details shown on the three privacy pages.
# Use real information; do not paste credentials here. Blank values show a preview notice.
# All six fields and an HTTPS SITE_URL are required before SITE_INDEXABLE=true.
OPERATOR_NAME=
CONTACT_EMAIL=
HOSTING_PROVIDER=
# Describe actual application AND hosting/proxy logging and retention in each language.
# Setting these statements does not change the host's log retention settings.
PRIVACY_LOG_NOTICE_PT=
PRIVACY_LOG_NOTICE_EN=
PRIVACY_LOG_NOTICE_ZH=

# Scan request deadline, in seconds (accepted range: 1..30).
# Each auxiliary request has its own deadline; a full scan can take longer.
SCAN_TIMEOUT=15
USER_AGENT=MandAPIGeoBot/0.2

# Single-process, in-memory limits. UTC midnight reset; restart clears counts.
FREE_SCAN_DAILY_LIMIT=3
MAX_CONCURRENT_SCANS=2

# Exact, known direct reverse-proxy peer IP(s), comma separated.
# Blank trusts no forwarded client-IP headers. Never use *.
# Docker's peer address may differ from the host's 127.0.0.1.
FORWARDED_ALLOW_IPS=

# Optional LLM summary. Rule-based scans do not need any key.
# Public summaries are opt-in on pt-BR, English and Chinese pages when enabled.
# Enabling this can send report data to your chosen provider and incur charges.
PUBLIC_AI_SUMMARY=false
LLM_BASE_URL=https://api.mandapi.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
